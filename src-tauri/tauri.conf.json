{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaFactory",
  "identifier": "com.mediafactory.app",
  "build": {
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaFactory",
        "url": "http://127.0.0.1:8765",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["python-backend/"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
